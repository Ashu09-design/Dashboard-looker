{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["uploads/**", "parsers/**", "services/**", "middleware/**", "public/**", "data/**"],
        "memory": 1024,
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "server.js" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
